# LiveKit Cloud credentials — populate with `lk app env -w .`
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Moss — patient knowledge base (https://docs.moss.dev/docs). Required for
# real PATIENT_CONTEXT retrieval; if MOSS_PROJECT_ID is unset, Sotto runs with
# retrieval disabled (no invented patient data).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_MODEL_ID=moss-minilm
# Per-patient intake index (Phase 1+2 + reports), built by scripts/build_patient_kb.py.
MOSS_PATIENT_INDEX_NAME=patient_context
# Shared Aether Loop question library (KB_CANDIDATES), built by scripts/build_aether_kb.py.
MOSS_AETHER_INDEX_NAME=aether_kb
# Which patient's records to scope intake retrieval to (fixed demo patient for now).
SOTTO_PATIENT_ID=demo-maya-chen
