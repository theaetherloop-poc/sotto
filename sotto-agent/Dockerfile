# syntax=docker/dockerfile:1
#
# Dockerfile for the Sotto Python agent, optimized for `lk agent deploy` to LiveKit Cloud.
# Based on the LiveKit-recommended uv template, with CMD pointing at our entrypoint at
# src/sotto_agent.py (the autogenerated template assumes agent.py at project root).

# Debian 13 "trixie" (glibc 2.41), not bookworm (glibc 2.36): the Moss native dep
# inferedge-moss-core only ships manylinux_2_38+ wheels, which need glibc >= 2.38.
ARG PYTHON_VERSION=3.13
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-trixie-slim AS base

ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1

# --- Build stage ---
FROM base AS build

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    python3-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cache dependency install across code-only changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked

# Sotto doesn't use plugins that need pre-downloaded weights (Deepgram STT and OpenAI LLM
# both run through LiveKit Inference and don't require local models), so we skip the
# `download-files` step that's in the default template. Re-enable if you add a local
# turn-detector or similar.

COPY . .

# --- Production stage ---
FROM base

ARG UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/app" \
    --shell "/sbin/nologin" \
    --uid "${UID}" \
    appuser

WORKDIR /app

COPY --from=build --chown=appuser:appuser /app /app

USER appuser

# Worker mode (the `start` subcommand) — connects to LiveKit and waits for room dispatch.
CMD ["uv", "run", "src/sotto_agent.py", "start"]
